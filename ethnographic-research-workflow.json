      },
      "id": "a244e522-6eb6-436d-9988-0413df18587f",
      "name": "🔬 Gemini: Ethnographic Analysis",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        944,
        3088
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "${N8N_GOOGLE_GEMINI_CREDENTIAL_ID}",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const analysis = $json.text || $json.response || $json.content || '';\nconst senderEmail = $json.senderEmail || 'unknown';\nconst fileName = $json.fileName || 'interview';\nconst today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });\n\nfunction mdToRtf(text) {\n  return text\n    .replace(/^## (.+)$/gm, '{\\\\pard\\\\sb300\\\\b\\\\fs28 $1\\\\b0\\\\par}')\n    .replace(/^### (.+)$/gm, '{\\\\pard\\\\sb200\\\\b\\\\fs24 $1\\\\b0\\\\par}')\n    .replace(/\\*\\*(.+?)\\*\\*/g, '{\\\\b $1\\\\b0}')\n    .replace(/^- (.+)$/gm, '{\\\\pard\\\\li720\\\\bullet  $1\\\\par}')\n    .replace(/^(?!\\{\\\\pard)(.+)$/gm, '{\\\\pard $1\\\\par}')\n    .replace(/^\\s*$/gm, '{\\\\pard\\\\par}');\n}\n\nconst safeFileName = fileName.replace(/[{}\\\\]/g, '');\nconst rtfBody = mdToRtf(analysis);\n\nconst rtfContent = `{\\\\rtf1\\\\ansi\\\\deff0\\n{\\\\fonttbl{\\\\f0\\\\froman\\\\fcharset0 Times New Roman;}{\\\\f1\\\\fswiss\\\\fcharset0 Arial;}}\\n{\\\\colortbl ;\\\\red0\\\\green105\\\\blue111;\\\\red100\\\\green100\\\\blue100;}\\n\\\\widowctrl\\\\hyphauto\\n{\\\\pard\\\\qc\\\\cf1\\\\f1\\\\fs40\\\\b ETHNOGRAPHIC RESEARCH REPORT\\\\b0\\\\par}\\n{\\\\pard\\\\qc\\\\cf2\\\\f1\\\\fs20 AI-Powered Qualitative Analysis | ${today}\\\\par}\\n{\\\\pard\\\\qc\\\\cf2\\\\f1\\\\fs20 Source: ${safeFileName}\\\\par}\\n{\\\\pard\\\\par}\\n\\\\f0\\\\fs22\\n${rtfBody}\\n{\\\\pard\\\\par}\\n{\\\\pard\\\\f1\\\\fs16\\\\cf2 End of Report | Powered by Google Gemini via n8n Automation\\\\par}\\n}`;\n\nconst base64Rtf = Buffer.from(rtfContent, 'utf-8').toString('base64');\nconst outputFileName = `Ethnographic_Report_${fileName.replace(/\\.[^.]+$/, '').replace(/\\s+/g, '_')}_${Date.now()}.rtf`;\n\nreturn [{\n  json: { senderEmail, fileName, outputFileName, today },\n  binary: {\n    rtfFile: {\n      data: base64Rtf,\n      mimeType: 'application/rtf',\n      fileName: outputFileName,\n      fileExtension: 'rtf'\n    }\n  }\n}];"
      },
      "id": "fbe5ab0e-988c-4053-8d23-9364f16ba671",
      "name": "📝 Create RTF Report File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        2864
      ]
