    {
      "parameters": {
        "fromEmail": "${N8N_SENDER_EMAIL}",
        "toEmail": "={{ $('📧 Email Trigger (IMAP)').item.json.headers['return-path'] }}",
        "subject": "=Re:{{ $('📧 Email Trigger (IMAP)').item.json.headers.subject.replace(/^Subject:\\s*/i, '').trim() }}",
        "text": "=Thank you for submitting your research file. Your ethnographic analysis report is ready and attached to this email.\n\nReport Details:\n• Source File: {{ $json.fileName }}\n• Generated On: {{ $json.today }}\n• Analysis Type: AI-Powered Ethnographic Research\n\nThe attached RTF file includes an executive summary, key themes and patterns, participant behaviors, cultural insights, notable quotes, and actionable recommendations.\n\nPlease open the attached file {{ $('📄 Prepare Text Transcript').item.json.fileName }} to review your full report.\n\nIf you have any questions or would like to submit another file for analysis, simply send a new email with the subject \"Perform Ethnographic Research\" and attach your video, audio, or text file.\n\nBest regards,\nEthnographic Research Automation\n${N8N_SENDER_EMAIL}",
        "options": {
          "attachments": "rtfFile"
        }
      },
