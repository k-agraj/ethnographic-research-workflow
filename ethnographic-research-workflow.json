    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert qualitative researcher. Analyze the following interview transcript using ethnographic research methods.\n\nTranscript:\n{{ $json.transcript }}\n\nProvide a structured ethnographic analysis including:\n## 1. Executive Summary\n## 2. Key Themes & Patterns\n## 3. Participant Behaviors & Observations\n## 4. Cultural Insights\n## 5. Notable Quotes\n## 6. Recommendations\n\nBe thorough, analytical, and use academic ethnographic framing."
      },
      "id": "2ff08dc6-a486-4154-9cca-692698505044",
      "name": "⛓️ Ethnographic Analysis Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        864,
        2864
      ]
    },
    {
      "parameters": {
